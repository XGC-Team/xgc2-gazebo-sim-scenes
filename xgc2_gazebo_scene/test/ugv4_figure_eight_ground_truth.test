<launch>
  <env name="GAZEBO_MASTER_URI" value="http://127.0.0.1:11457"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"
         value="$(find gazebo_sim_worlds)/worlds/ugv4_figure_eight_obstacles/ugv4_figure_eight_obstacles.world"/>
    <arg name="gui" value="false"/>
    <arg name="verbose" value="false"/>
    <arg name="extra_gazebo_args" value="-s libxgc2_gazebo_scene_system.so"/>
  </include>

  <test test-name="ugv4_figure_eight_ground_truth"
        pkg="xgc2_gazebo_scene"
        type="scene_ground_truth_test.py"
        time-limit="60">
    <param name="manifest"
           value="$(find gazebo_sim_worlds)/worlds/ugv4_figure_eight_obstacles/source_manifest.json"/>
    <param name="timeout" value="30"/>
  </test>
</launch>
