#!/usr/bin/env python3
"""Explicitly materialize a versioned world within a caller-supplied write grant."""
import argparse
import json
import sys
from xgc2_scene_runtime.prepare import prepare, read
from xgc2_scene_runtime.store import unique_object

def main():
    parser = argparse.ArgumentParser()
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument('--request', help='JSON request file')
    source.add_argument('--request-json', help='Inline JSON request')
    arguments = parser.parse_args()
    try:
        raw = read(arguments.request, 65536) if arguments.request else arguments.request_json
        if len(raw) > 65536:
            raise ValueError('Prepare request exceeds 64 KiB')
        value = json.loads(raw, object_pairs_hook=unique_object,
                           parse_constant=lambda _: (_ for _ in ()).throw(ValueError('Nonfinite JSON')))
        print(json.dumps(prepare(value), allow_nan=False, separators=(',', ':')))
    except (ValueError, OSError, TypeError, KeyError) as error:
        print('simulation_world_prepare: '+str(error), file=sys.stderr)
        return 1
    return 0

if __name__ == '__main__':
    raise SystemExit(main())
