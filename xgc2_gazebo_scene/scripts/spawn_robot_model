#!/usr/bin/env python3
"""Read a user model asset and submit one bound simulation-v1 creation.

ROS is only the launch-time asset input. The world owns serialization, native
realization and completion; this client never probes or replays a spawn.
"""
import argparse
import json
import math
import os
import sys
import xml.etree.ElementTree as ET

from xgc2_xrpc.runtime import Runtime
from xgc2_scene_runtime.simulation_client import SimulationClient


def quaternion_from_rpy(roll, pitch, yaw):
    cy, sy = math.cos(yaw*.5), math.sin(yaw*.5)
    cp, sp = math.cos(pitch*.5), math.sin(pitch*.5)
    cr, sr = math.cos(roll*.5), math.sin(roll*.5)
    return [sr*cp*cy-cr*sp*sy, cr*sp*cy+sr*cp*sy, cr*cp*sy-sr*sp*cy, cr*cp*cy+sr*sp*sy]


def parse_arguments(argv):
    parser = argparse.ArgumentParser(prog='spawn_robot_model')
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument('-urdf', action='store_true')
    source.add_argument('-sdf', action='store_true')
    parser.add_argument('-param', required=True)
    parser.add_argument('-model', required=True)
    parser.add_argument('-simulation_service_ref_json', required=True)
    parser.add_argument('-target_id', required=True)
    parser.add_argument('-robot_namespace', default=None)
    for axis in ('x', 'y', 'z', 'R', 'P', 'Y'):
        parser.add_argument('-'+axis, type=float, default=0.0)
    parser.add_argument('-operation_timeout', type=float, default=30.0)
    parser.add_argument('-hold', action='store_true')
    return parser.parse_args([value for value in argv[1:] if ':=' not in value])


def entity(args, model_xml, namespace):
    if not all(math.isfinite(getattr(args, axis)) for axis in ('x', 'y', 'z', 'R', 'P', 'Y')):
        raise ValueError('Robot pose must be finite')
    if not isinstance(model_xml, str) or not model_xml.strip():
        raise ValueError('Robot asset parameter is empty')
    ET.fromstring(model_xml)
    return {'id': args.model, 'role': 'robot',
            'asset': {'id': args.model, 'realization': {
                'media_type': 'application/urdf+xml' if args.urdf else 'application/sdf+xml',
                'content': model_xml}},
            'pose': {'position': [args.x, args.y, args.z],
                     'orientation': quaternion_from_rpy(args.R, args.P, args.Y)},
            'parameters': {'ros_namespace': namespace}}


def main(argv=None):
    args = parse_arguments(sys.argv if argv is None else argv)
    if not math.isfinite(args.operation_timeout) or not 0 < args.operation_timeout <= 60:
        raise SystemExit('operation_timeout must be in (0, 60] seconds')
    import rospy
    rospy.init_node('spawn_'+args.model, anonymous=True, disable_signals=True, disable_rostime=True)
    runtime = Runtime(blocking_workers=1, max_calls=2)
    client = None
    try:
        value = entity(args, rospy.get_param(args.param),
                       rospy.get_namespace() if args.robot_namespace is None else args.robot_namespace)
        client = SimulationClient(json.loads(args.simulation_service_ref_json), runtime=runtime,
                                  local_target=args.target_id, timeout=args.operation_timeout)
        result = client.operation('/v1/entities', {'entity': value})
        print('SPAWN_ROBOT_MODEL_RESULT '+json.dumps(result), flush=True)
    except (ValueError, OSError, KeyError, ET.ParseError) as error:
        print('spawn_robot_model: '+str(error), file=sys.stderr, flush=True)
        raise SystemExit(1)
    finally:
        if client is not None:
            client.close()
        runtime.close()
        rospy.signal_shutdown('native entity creation finished')
    if args.hold:
        os.execvp('sleep', ['sleep', '2147483647'])


if __name__ == '__main__':
    main()
