<?xml version="1.0"?>
<package format="2">
  <name>xgc2_gazebo_scene</name>
  <version>0.1.0</version>
  <description>Native Gazebo Classic simulation service, exact scene geometry and ROS user-data projections.</description>

  <maintainer email="lxk36@users.noreply.github.com">XGC2</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>

  <build_depend>gazebo_dev</build_depend>
  <build_depend>libeigen3-dev</build_depend>
  <build_export_depend>gazebo_dev</build_export_depend>
  <depend>geometry_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>xgc2_geometry_msgs</depend>
  <build_depend>libxgc2-xrpc-dev</build_depend>
  <build_export_depend>libxgc2-xrpc-dev</build_export_depend>
  <exec_depend>libxgc2-xrpc1</exec_depend>
  <build_depend>libxgc2-robotics-interfaces-dev</build_depend>
  <build_export_depend>libxgc2-robotics-interfaces-dev</build_export_depend>
  <build_depend>libjsoncpp-dev</build_depend>
  <build_export_depend>libjsoncpp-dev</build_export_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>xgc2_scene_runtime</exec_depend>

  <test_depend>rostest</test_depend>
  <test_depend>std_srvs</test_depend>
  <test_depend>xgc2_scene_runtime</test_depend>

  <export>
    <gazebo_ros plugin_path="${prefix}/lib" />
  </export>
</package>
