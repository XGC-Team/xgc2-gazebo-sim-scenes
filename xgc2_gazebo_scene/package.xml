<?xml version="1.0"?>
<package format="2">
  <name>xgc2_gazebo_scene</name>
  <version>0.1.0</version>
  <description>Gazebo Classic scene director with legacy path animation and XGC2-managed obstacle control.</description>

  <maintainer email="lxk36@users.noreply.github.com">XGC2</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>

  <build_depend>gazebo_dev</build_depend>
  <build_depend>libeigen3-dev</build_depend>
  <build_export_depend>gazebo_dev</build_export_depend>
  <depend>geometry_msgs</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>message_runtime</exec_depend>

  <test_depend>rostest</test_depend>

  <export>
    <gazebo_ros plugin_path="${prefix}/lib" />
  </export>
</package>
