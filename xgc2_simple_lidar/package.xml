<?xml version="1.0"?>
<package format="2">
  <name>xgc2_simple_lidar</name>
  <version>0.1.0</version>
  <description>Ideal world-frame XYZ observations from Gazebo Classic GPU rays.</description>
  <maintainer email="lxk36@users.noreply.github.com">XGC2</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>gazebo_dev</build_depend>
  <build_export_depend>gazebo_dev</build_export_depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <test_depend>rospy</test_depend>
  <test_depend>gazebo_msgs</test_depend>
  <export><gazebo_ros plugin_path="${prefix}/lib" /></export>
</package>
