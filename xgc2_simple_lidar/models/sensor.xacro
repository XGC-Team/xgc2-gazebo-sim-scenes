<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- The only definition of the scan defaults. The macro parameters and the
       sensor.sdf.xacro arguments both read these properties. -->
  <xacro:property name="xgc2_simple_lidar_default_rate" value="10"/>
  <xacro:property name="xgc2_simple_lidar_default_max_range" value="20"/>
  <xacro:property name="xgc2_simple_lidar_default_samples" value="360"/>
  <xacro:property name="xgc2_simple_lidar_default_layers" value="16"/>
  <xacro:property name="xgc2_simple_lidar_default_vertical_fov" value="1.0"/>
  <xacro:property name="xgc2_simple_lidar_default_horizontal_fov" value="${2*pi}"/>
  <xacro:property name="xgc2_simple_lidar_default_acceleration" value="gpu"/>
  <xacro:macro name="xgc2_simple_lidar_sensor" params="namespace pose rate:=${xgc2_simple_lidar_default_rate} max_range:=${xgc2_simple_lidar_default_max_range} samples:=${xgc2_simple_lidar_default_samples} layers:=${xgc2_simple_lidar_default_layers} vertical_fov:=${xgc2_simple_lidar_default_vertical_fov} horizontal_fov:=${xgc2_simple_lidar_default_horizontal_fov} acceleration:=${xgc2_simple_lidar_default_acceleration}">
    <sensor name="simple_lidar" type="${dict(cpu='ray', gpu='gpu_ray')[acceleration]}">
      <pose>${pose}</pose>
      <always_on>false</always_on>
      <update_rate>${rate}</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>${samples}</samples><resolution>1</resolution>
            <min_angle>${-horizontal_fov / 2}</min_angle><max_angle>${horizontal_fov / 2}</max_angle>
          </horizontal>
          <vertical>
            <samples>${layers}</samples><resolution>1</resolution>
            <min_angle>${-vertical_fov / 2}</min_angle><max_angle>${vertical_fov / 2}</max_angle>
          </vertical>
        </scan>
        <range><min>0.15</min><max>${max_range}</max><resolution>0.01</resolution></range>
      </ray>
      <plugin name="simple_lidar" filename="${dict(cpu='libxgc2_simple_lidar_cpu.so', gpu='libxgc2_simple_lidar.so')[acceleration]}">
        <robotNamespace>${namespace}</robotNamespace>
      </plugin>
    </sensor>
  </xacro:macro>
</robot>
