<sdf version="1.6"><world name="default"><gravity>0 0 0</gravity>
<physics type="ode"><max_step_size>0.002</max_step_size><real_time_update_rate>500</real_time_update_rate></physics>
<scene><ambient>0.5 0.5 0.5 1</ambient><shadows>false</shadows></scene>
<model name="front"><static>true</static><pose>5.05 0 3 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>0.1 20 10</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 20 10</size></box></geometry></visual></link></model><model name="back"><static>true</static><pose>-6.05 0 3 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>0.1 20 10</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 20 10</size></box></geometry></visual></link></model><model name="left"><static>true</static><pose>0 4.05 3 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>20 0.1 10</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.1 10</size></box></geometry></visual></link></model><model name="right"><static>true</static><pose>0 -3.05 3 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>20 0.1 10</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 0.1 10</size></box></geometry></visual></link></model><model name="floor"><static>true</static><pose>0 0 -0.05 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>20 20 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 20 0.1</size></box></geometry></visual></link></model><model name="ceiling"><static>true</static><pose>0 0 6.05 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>20 20 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 20 0.1</size></box></geometry></visual></link></model>
<model name="scanner"><pose>0 0 1 0 0 0</pose><link name="base_link"><gravity>false</gravity>
<inertial><mass>1</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
<sensor name="simple_lidar" type="gpu_ray"><pose>0.3 -0.2 0.4 0.1 -0.12 0.15</pose><always_on>false</always_on><update_rate>10</update_rate>
<ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal><vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.5</min_angle><max_angle>0.5</max_angle></vertical></scan><range><min>0.15</min><max>20</max><resolution>0.01</resolution></range></ray>
<plugin name="simple_lidar" filename="libxgc2_simple_lidar.so"><robotNamespace>/test_robot</robotNamespace></plugin>
</sensor></link></model></world></sdf>