#!/usr/bin/env python3
"""Execute the explicitly prepared native world; ROS is a user-data edge."""
import argparse
import json
import os
import math
from pathlib import Path
import shutil
import sys
import tempfile
import xml.etree.ElementTree as ET


def absolute_file(value, label, maximum):
    path = Path(value)
    if not path.is_absolute() or not path.is_file():
        raise ValueError(label+' must identify an existing absolute file')
    path = path.resolve(strict=True)
    if path.stat().st_size <= 0 or path.stat().st_size > maximum:
        raise ValueError(label+' exceeds its bounded input size or is empty')
    return path


def read(path, limit):
    with Path(path).open('rb') as stream:
        data = stream.read(limit+1)
    if not data or len(data) > limit:
        raise ValueError('Input {} exceeds its {} byte limit or is empty'.format(path, limit))
    return data


def atomic(path, data):
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=str(path.parent), prefix='.'+path.name+'.', delete=False) as stream:
            temporary = stream.name
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, str(path))
        directory = os.open(str(path.parent), os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if temporary and os.path.exists(temporary):
            os.unlink(temporary)


def compose(arguments, environment):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--world', required=True)
    parser.add_argument('--socket-path', help='Core-allocated private native world endpoint')
    for name in ('paused', 'gui', 'ros-data'):
        parser.add_argument('--'+name, required=True, choices=('true', 'false'))
    parser.add_argument('--vrpn-config', default='')
    parser.add_argument('--vrpn-tracker-ports', default='', help='JSON mapping of tracker names to dedicated listener ports')
    parser.add_argument('--gazebo-bin', default='')
    parser.add_argument('--plugin-dir', action='append', default=[])
    parser.add_argument('--verbose', nargs='?', const='true', default='false', choices=('true', 'false'))
    parser.add_argument('--physics', choices=('ode', 'bullet', 'simbody', 'dart'), default='')
    parser.add_argument('--allow-online-models', default='false', choices=('true', 'false'))
    for name, kind in (('bind-address', str), ('port', int), ('publish-rate', float),
                       ('scan-interval', float), ('stale-timeout', float),
                       ('velocity-filter-cutoff', float), ('acceleration-filter-cutoff', float),
                       ('derivative-reset-timeout', float), ('match-mode', str), ('tracker-patterns', str)):
        parser.add_argument('--vrpn-'+name, type=kind)
    parser.add_argument('--vrpn-auto-track-known-models', choices=('true', 'false'))
    parser.add_argument('--clock-rate-hz', type=float, default=None)
    args, remappings = parser.parse_known_args(arguments)
    mapped = {}
    for value in remappings:
        key, separator, target = value.partition(':=')
        if separator != ':=' or key not in ('__name', '__ns', '__log') or not target or key in mapped:
            raise ValueError('Only explicit ROS name, namespace and log remappings are supported')
        mapped[key] = target
    world = absolute_file(args.world, '--world', 8*1024*1024)
    raw = world.read_bytes()
    if b'<!DOCTYPE' in raw.upper() or b'<!ENTITY' in raw.upper():
        raise ValueError('Prepared worlds cannot declare XML entities')
    sdf = ET.fromstring(raw)
    worlds = sdf.findall('world')
    if sdf.tag != 'sdf' or len(worlds) != 1:
        raise ValueError('A prepared single-world SDF is required')
    native = [p for p in worlds[0].findall('plugin') if p.get('filename') == 'libxgc2_simulation_world.so']
    if len(native) != 1 or any(not native[0].findtext(key) for key in ('socket_path', 'target_id', 'resource_root')):
        raise ValueError('The world must contain exactly one explicitly configured native XRPC authority')
    rate = float(native[0].findtext('clock_rate_hz', '0')) if args.clock_rate_hz is None else args.clock_rate_hz
    if not math.isfinite(rate) or not 0 <= rate <= 1e6:
        raise ValueError('--clock-rate-hz must be finite in [0, 1000000]')
    env = dict(environment)
    # This entry owns a local World; ROS_IP remains a separate user-data edge.
    env['IGN_IP'] = '127.0.0.1'
    env.pop('XGC_SIM_SOCKET_PATH', None)
    if args.socket_path is not None:
        socket_path = args.socket_path
        if (not os.path.isabs(socket_path) or os.path.normpath(socket_path) != socket_path
                or socket_path.startswith('//') or socket_path == '/'
                or '\x00' in socket_path or len(os.fsencode(socket_path)) > 107):
            raise ValueError('--socket-path must be a canonical absolute Unix socket path')
        env['XGC_SIM_SOCKET_PATH'] = socket_path
    if args.allow_online_models == 'false': env['GAZEBO_MODEL_DATABASE_URI'] = 'http://127.0.0.1:9'
    for key in ('XGC_SIM_VRPN_CONFIG', 'XGC_SIM_ROS_NAME', 'XGC_SIM_ROS_NAMESPACE', 'XGC_SIM_ROS_LOG', 'XGC_SIM_ROS_CLOCK_RATE_HZ'):
        env.pop(key, None)
    for key, variable in (('__name', 'XGC_SIM_ROS_NAME'), ('__ns', 'XGC_SIM_ROS_NAMESPACE'), ('__log', 'XGC_SIM_ROS_LOG')):
        if key in mapped: env[variable] = mapped[key]
    plugins = ['libxgc2_simple_lidar_cpu.so', 'libxgc2_simple_lidar.so']
    if args.ros_data == 'true':
        plugins.append('libgazebo_ros_paths_plugin.so')
        plugins.append('libxgc2_simulation_ros_data.so')
        env['XGC_SIM_ROS_CLOCK_RATE_HZ'] = str(rate)
    if args.vrpn_tracker_ports and not args.vrpn_config:
        raise ValueError('--vrpn-tracker-ports requires --vrpn-config')
    if args.vrpn_config:
        if args.ros_data != 'true': raise ValueError('VRPN user data requires --ros-data true')
        vrpn_path = absolute_file(args.vrpn_config, '--vrpn-config', 1024*1024)
        overrides = {}
        if args.vrpn_tracker_ports:
            def unique_pairs(pairs):
                result = {}
                for key, value in pairs:
                    if key in result: raise ValueError('Duplicate tracker in --vrpn-tracker-ports')
                    result[key] = value
                return result
            try:
                tracker_ports = json.loads(args.vrpn_tracker_ports, object_pairs_hook=unique_pairs)
            except (json.JSONDecodeError, RecursionError) as error:
                raise ValueError('--vrpn-tracker-ports must be a JSON mapping') from error
            if (not isinstance(tracker_ports, dict) or len(tracker_ports) > 128 or
                    any(not name or len(name) > 256 or name.strip('/') != name or
                        any(ord(c) < 32 or ord(c) == 127 for c in name) or
                        type(port) is not int or not 1 <= port <= 65535
                        for name, port in tracker_ports.items()) or
                    len(set(tracker_ports.values())) != len(tracker_ports)):
                raise ValueError('--vrpn-tracker-ports must map unique tracker names to unique ports in 1..65535')
            overrides['tracker_ports'] = tracker_ports
        for name in ('bind_address', 'port', 'publish_rate', 'scan_interval', 'stale_timeout',
                     'velocity_filter_cutoff', 'acceleration_filter_cutoff', 'derivative_reset_timeout',
                     'match_mode', 'auto_track_known_models'):
            value = getattr(args, 'vrpn_'+name)
            if value is not None:
                if name == 'auto_track_known_models': value = value == 'true'
                overrides[name] = value
        if args.vrpn_tracker_patterns:
            overrides['trackers'] = [part.strip() for part in args.vrpn_tracker_patterns.replace(';', ',').replace('\n', ',').split(',') if part.strip()]
        if overrides:
            import yaml
            config = yaml.safe_load(read(vrpn_path, 1024*1024))
            if not isinstance(config, dict): raise ValueError('Native VRPN config must contain one mapping')
            config.update(overrides)
            vrpn_path = world.parent/'native-vrpn.yaml'
            atomic(vrpn_path, yaml.safe_dump(config, allow_unicode=True).encode('utf-8'))
        env['XGC_SIM_VRPN_CONFIG'] = str(vrpn_path)
        plugins.append('libgazebo_sim_vrpn_system_plugin.so')
    directories = []
    for value in args.plugin_dir:
        path = Path(value)
        if not path.is_absolute() or not path.is_dir(): raise ValueError('--plugin-dir must identify an absolute library directory')
        directories.append(str(path.resolve(strict=True)))
    if directories:
        env['GAZEBO_PLUGIN_PATH'] = os.pathsep.join(directories+([env['GAZEBO_PLUGIN_PATH']] if env.get('GAZEBO_PLUGIN_PATH') else []))
    executable = args.gazebo_bin or shutil.which('gazebo' if args.gui == 'true' else 'gzserver', path=env.get('PATH'))
    if not executable: raise ValueError('The selected native Gazebo executable is not installed')
    executable = str(absolute_file(executable, '--gazebo-bin', 256*1024*1024))
    if not os.access(executable, os.X_OK): raise ValueError('The selected native Gazebo binary is not executable')
    argv = [executable]
    if args.verbose == 'true': argv.append('--verbose')
    if args.physics: argv += ['-e', args.physics]
    if args.paused == 'true': argv.append('-u')
    for plugin in plugins: argv += ['-s', plugin]
    argv.append(str(world))
    return executable, argv, env


def main(arguments=None):
    try:
        executable, argv, environment = compose(sys.argv[1:] if arguments is None else arguments, os.environ)
        os.execve(executable, argv, environment)
    except (OSError, ValueError, ET.ParseError) as error:
        print('native_world_start: '+str(error), file=sys.stderr)
        return 2

if __name__ == '__main__': sys.exit(main())
