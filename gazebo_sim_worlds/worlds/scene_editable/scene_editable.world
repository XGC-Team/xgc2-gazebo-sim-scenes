<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <physics name="scene_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <!-- Capability only. The independent user workflow loads the scene YAML. -->
    <plugin name="xgc2_scene_authoring" filename="libxgc2_scene_authoring_world.so">
      <scene_namespace>/xgc/scene</scene_namespace>
      <apply_timeout>5</apply_timeout>
    </plugin>
  </world>
</sdf>
