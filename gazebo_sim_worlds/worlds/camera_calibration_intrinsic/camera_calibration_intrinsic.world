<?xml version="1.0"?>
<sdf version="1.6">
  <world name="camera_calibration_intrinsic">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.15 0.18 0.22 1</background>
      <shadows>true</shadows>
    </scene>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <include>
      <uri>model://checkerboard_8x6</uri>
      <name>intrinsic_checkerboard</name>
      <!-- Keep the board comfortably above the ground so every automatic
           calibration view can keep the movable camera at z >= 1.4 m. -->
      <pose>2 0 2.2 0 0 0</pose>
    </include>
  </world>
</sdf>
