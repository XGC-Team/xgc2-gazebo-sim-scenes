<?xml version="1.0"?>
<sdf version="1.6">
  <world name="corridor_baseline">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver>
        <constraints><cfm>0</cfm><erp>0.2</erp><contact_max_correcting_vel>100</contact_max_correcting_vel></constraints>
      </ode>
    </physics>

    <!-- 40 m by 6 m baseline corridor. The 1 m boxes alternate gently and
         leave at least 1.5 m usable passage for the 0.574 m Scout. -->
    <model name="baseline_bounds">
      <static>true</static>
      <link name="north_wall">
        <pose>20 3 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>41.15 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>41.15 0.15 2.5</size></box></geometry><material><ambient>0.55 0.55 0.55 1</ambient></material></visual>
      </link>
      <link name="south_wall">
        <pose>20 -3 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>41.15 0.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>41.15 0.15 2.5</size></box></geometry><material><ambient>0.55 0.55 0.55 1</ambient></material></visual>
      </link>
      <link name="west_wall">
        <pose>-0.5 0 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 6.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 6.15 2.5</size></box></geometry></visual>
      </link>
      <link name="east_wall">
        <pose>40.5 0 1.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 6.15 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 6.15 2.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="baseline_box_1">
      <static>true</static><pose>6 0.9 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1 2</size></box></geometry><material><ambient>0.75 0.2 0.15 1</ambient></material></visual>
      </link>
    </model>
    <model name="baseline_box_2">
      <static>true</static><pose>13 -0.9 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1 2</size></box></geometry><material><ambient>0.75 0.2 0.15 1</ambient></material></visual>
      </link>
    </model>
    <model name="baseline_box_3">
      <static>true</static><pose>20 0.9 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1 2</size></box></geometry><material><ambient>0.75 0.2 0.15 1</ambient></material></visual>
      </link>
    </model>
    <model name="baseline_box_4">
      <static>true</static><pose>27 -0.9 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1 2</size></box></geometry><material><ambient>0.75 0.2 0.15 1</ambient></material></visual>
      </link>
    </model>
    <model name="baseline_box_5">
      <static>true</static><pose>34 0.9 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 1 2</size></box></geometry><material><ambient>0.75 0.2 0.15 1</ambient></material></visual>
      </link>
    </model>
  </world>
</sdf>
