        <geometry><box><size>0.010 0.2044 0.2044</size></box></geometry>
      </collision>
      <visual name="plate_backing">
        <geometry><box><size>0.010 0.2044 0.2044</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
      </visual>
      <visual name="official_aprilgrid_target">
        <pose>-0.0061 0 0 0 0 0</pose>
        <geometry><box><size>0.002 0.1944 0.1944</size></box></geometry>
        <cast_shadows>false</cast_shadows>
        <material>
          <script>
            <uri>model://aprilgrid_6x6_tag36h11_24mm_a4/materials/scripts</uri>
