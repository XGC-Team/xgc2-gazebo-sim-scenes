<?xml version="1.0"?>
<sdf version="1.6">
  <model name="aprilgrid_6x6_tag36h11_88mm">
    <static>true</static>
    <link name="board">
      <!--
        Calibration datum (first tag edge through last tag edge):
          6 * 0.088 + 5 * 0.0264 = 0.6600 m

        Kalibr's symmetric corner marks extend one 0.0264 m gap beyond that
        datum on every side, so the rendered target face is 0.7128 m square.
        The white 10 mm surround models the field plate without changing any
        target coordinates consumed by the calibrator.
      -->
      <collision name="plate_collision">
        <geometry><box><size>0.020 0.7328 0.7328</size></box></geometry>
      </collision>
      <visual name="plate_backing">
        <geometry><box><size>0.020 0.7328 0.7328</size></box></geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name>
          </script>
        </material>
      </visual>
      <visual name="official_aprilgrid_target">
        <!-- Camera starts on the negative-X side; expose the textured face there. -->
        <pose>-0.0111 0 0 0 0 0</pose>
        <geometry>
          <!--
            Gazebo Classic does not reliably bind model-local scripted
            textures to a vertical <plane>.  A 2 mm box gives Ogre stable UVs
            while keeping the rendered face at the exact Kalibr export size.
          -->
          <box><size>0.002 0.7128 0.7128</size></box>
        </geometry>
        <cast_shadows>false</cast_shadows>
        <material>
          <script>
            <uri>model://aprilgrid_6x6_tag36h11_88mm/materials/scripts</uri>
            <uri>model://aprilgrid_6x6_tag36h11_88mm/materials/textures</uri>
            <name>XGC2/AprilGrid6x6Tag36h11_88mm</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
