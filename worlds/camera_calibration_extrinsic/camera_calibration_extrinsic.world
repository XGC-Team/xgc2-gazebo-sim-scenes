<?xml version="1.0"?>
<sdf version="1.6">
  <world name="camera_calibration_extrinsic">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.15 0.18 0.22 1</background>
      <shadows>true</shadows>
    </scene>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <include><uri>model://cal_marker_red</uri><name>cal_marker_01</name><pose>2.0 -1.2 0.6 0 0 0</pose></include>
    <include><uri>model://cal_marker_green</uri><name>cal_marker_02</name><pose>2.2 1.3 0.8 0 0 0</pose></include>
    <include><uri>model://cal_marker_blue</uri><name>cal_marker_03</name><pose>3.2 -1.4 2.2 0 0 0</pose></include>
    <include><uri>model://cal_marker_yellow</uri><name>cal_marker_04</name><pose>3.4 1.4 2.6 0 0 0</pose></include>
    <include><uri>model://cal_marker_purple</uri><name>cal_marker_05</name><pose>4.3 -0.4 1.4 0 0 0</pose></include>
    <include><uri>model://cal_marker_turquoise</uri><name>cal_marker_06</name><pose>4.6 0.8 2.0 0 0 0</pose></include>
  </world>
</sdf>
