<?xml version="1.0"?>
<sdf version="1.6">
  <model name="cal_marker_red">
    <static>true</static>
    <link name="marker">
      <visual name="visual">
        <geometry><sphere><radius>0.14</radius></sphere></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
      </visual>
      <collision name="collision">
        <geometry><sphere><radius>0.14</radius></sphere></geometry>
      </collision>
    </link>
  </model>
</sdf>
