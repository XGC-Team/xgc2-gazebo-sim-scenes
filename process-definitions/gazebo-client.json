{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "gazebo-client",
      "version": "1.3.1",
      "label": "Gazebo client",
      "description": "Gazebo Classic GUI connected to the shared local Gazebo server. Startup probes stay lenient because gzclient is often slow on modest machines.",
      "parameters": {
        "properties": {
          "masterHost": {
            "type": "string",
            "description": "Gazebo master host reached by this GUI; a non-loopback value attaches to a server on another machine",
            "default": "127.0.0.1"
          },
          "masterPort": {
            "type": "integer",
            "default": 11345,
            "minimum": 1,
            "maximum": 65535
          },
          "rosRuntimePrefix": {
            "type": "string",
            "description": "Trusted ROS runtime prefix containing locally installed Gazebo models",
            "default": "/opt/ros/noetic",
            "x-xgc-path-kind": "directory",
            "enum": [
              "/opt/ros/noetic"
            ]
          },
          "modelDatabaseUri": {
            "type": "string",
            "default": "http://127.0.0.1:9",
            "description": "Offline by default; pass the selected model database URI explicitly to allow online models."
          }
        },
        "required": []
      },
      "command": {
        "executable": "gzclient",
        "args": [
          "-g",
          "${rosRuntimePrefix}/lib/libxgc2_gazebo_rendering.so"
        ],
        "env": {
          "GAZEBO_MASTER_URI": "http://${masterHost}:${masterPort}",
          "GAZEBO_MODEL_PATH": "${rosRuntimePrefix}/share/gazebo_sim_worlds/models:${rosRuntimePrefix}/share/gazebo_sim_fs150_sitl/models:/usr/share/gazebo-11/models",
          "GAZEBO_MODEL_DATABASE_URI": "${modelDatabaseUri}"
        }
      },
      "setupFiles": [
        "${rosRuntimePrefix}/setup.bash"
      ],
      "readiness": {
        "kind": "none"
      },
      "stop": {
        "graceMs": 15000
      },
      "logs": {
        "maxBytes": 1048576,
        "files": 3
      }
    }
  ]
}
